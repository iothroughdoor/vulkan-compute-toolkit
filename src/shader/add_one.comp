#version 450

layout(binding=0) uniform UBO {
    uint len;
};

layout(std140, binding=1) buffer SSBO {
    float in_vec[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() 
{
    if (gl_GlobalInvocationID.x < len) {
        in_vec[gl_GlobalInvocationID.x] += 1;
    }
}
